# Copy this file to `.env` and adjust. `.env` is git-ignored.

PORT=5000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# --- BigQuery ---------------------------------------------------------------
# Your OWN Google Cloud project (not an employer's).
BIGQUERY_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=finance_apps
BIGQUERY_LOCATION=US

# Safety cap per query in bytes (default 1 GB). Keeps costs predictable.
BIGQUERY_MAX_BYTES_BILLED=1073741824

# Authentication: run `gcloud auth application-default login` and leave this empty.
# Only set it if you really need a service-account key file (never commit it).
GOOGLE_APPLICATION_CREDENTIALS=

# Print every SQL statement to the console (never logs bind values).
LOG_QUERIES=false

# Where SKYNET stores uploaded SOP files (default: backend/storage/sop)
# SOP_STORAGE_DIR=
