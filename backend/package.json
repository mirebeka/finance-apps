{
  "name": "finance-apps-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Express + BigQuery backend for the SPO, SKYNET and Asset PO Tracker demo apps",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node db/setup.js",
    "db:seed": "node db/seed/seed.js",
    "db:ddl": "node db/generateDdl.js",
    "db:reset": "node db/setup.js && node db/seed/seed.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.2",
    "multer": "^2.2.0"
  }
}
